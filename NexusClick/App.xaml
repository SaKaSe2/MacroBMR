<Application x:Class="NexusClick.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="BlueGrey" SecondaryColor="Indigo" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Premium Color Palette -->
            <SolidColorBrush x:Key="AppBackground" Color="#FAFAFA" />
            <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentColor" Color="#0A2540" />
            <SolidColorBrush x:Key="AccentHover" Color="#13294B" />
            <SolidColorBrush x:Key="TextPrimary" Color="#333333" />
            <SolidColorBrush x:Key="TextSecondary" Color="#777777" />
            <SolidColorBrush x:Key="BorderColor" Color="#E5E5E5" />
            
            <Style x:Key="PremiumCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackground}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="20" ShadowDepth="4" />
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
