<Window x:Class="MacroBMR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="BMR - Macro Studio" Height="720" Width="1060"
        MinHeight="600" MinWidth="850"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Base900}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextPrimary}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Title Bar Kustom (36px) ============ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="RecordCircleOutline" Width="18" Height="18" Foreground="{StaticResource Accent500}" VerticalAlignment="Center"/>
                    <TextBlock Text="BMR Studio" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Macro Recorder" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMaximize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon x:Name="IcoMaximize" Kind="WindowMaximize" Width="13" Height="13"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource TitleBarButtonStyle}" Click="BtnClose_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#EF4444"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,16">
                    <TextBlock Text="MENU" FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" Margin="12,0,0,8"/>

                    <ListBox x:Name="MenuListBox" SelectionChanged="MenuListBox_SelectionChanged" Background="Transparent" BorderThickness="0">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Height" Value="36"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="4,2" Padding="10,0">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentColor}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Accent500}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RecordCircleOutline" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Manual Record" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Pengaturan" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Main Content Area -->
            <Border Grid.Column="1" Padding="20" Background="{StaticResource Base900}">
                <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- Tab 0: Manual Record -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,8">
                                <!-- Unified Statistics Card (Single Box) -->
                                <Border Style="{StaticResource PremiumCard}" Padding="16,12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Stat 1: Total Aksi -->
                                        <StackPanel Grid.Column="0" Margin="8,0" HorizontalAlignment="Center">
                                            <TextBlock Text="TOTAL AKSI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="TxtStatTotal" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent500}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Rectangle Grid.Column="1" Fill="{StaticResource BorderSubtle}" Width="1" VerticalAlignment="Stretch"/>

                                        <!-- Stat 2: Interaksi -->
                                        <StackPanel Grid.Column="2" Margin="8,0" HorizontalAlignment="Center">
                                            <TextBlock Text="INTERAKSI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="TxtStatInteractions" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Rectangle Grid.Column="3" Fill="{StaticResource BorderSubtle}" Width="1" VerticalAlignment="Stretch"/>

                                        <!-- Stat 3: Estimasi Durasi -->
                                        <StackPanel Grid.Column="4" Margin="8,0" HorizontalAlignment="Center">
                                            <TextBlock Text="ESTIMASI DURASI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="TxtStatDuration" Text="0s" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Rectangle Grid.Column="5" Fill="{StaticResource BorderSubtle}" Width="1" VerticalAlignment="Stretch"/>

                                        <!-- Stat 4: Status -->
                                        <StackPanel Grid.Column="6" Margin="8,0" HorizontalAlignment="Center">
                                            <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="TxtStatStatus" Text="Idle" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Highlight300}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Unified Control & Settings Panel (Single Box) -->
                                <Border Style="{StaticResource PremiumCard}" Padding="16,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <!-- Row 1: Main Action Buttons -->
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnRecord" Click="BtnRecord_Click"
                                                    Style="{StaticResource ActionButtonStyle}" Width="160" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="RecordCircle" VerticalAlignment="Center" Margin="0,0,6,0" Width="16" Height="16"/>
                                                    <TextBlock Text="Record (Normal)" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="BtnPlay" Click="BtnPlay_Click"
                                                    Style="{StaticResource PrimaryButtonStyle}" Width="140" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0" Width="16" Height="16"/>
                                                    <TextBlock Text="Play Macro" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Content="Hapus Semua" Click="BtnClear_Click" Style="{StaticResource OutlinedButtonStyle}" Margin="0,0,10,0"/>

                                            <Button x:Name="BtnExport" Click="BtnExport_Click" ToolTip="Export Makro (.bmr)" Style="{StaticResource IconButtonStyle}" Margin="0,0,6,0">
                                                <materialDesign:PackIcon Kind="Download" Width="16" Height="16"/>
                                            </Button>

                                            <Button x:Name="BtnImport" Click="BtnImport_Click" ToolTip="Import Makro (.bmr)" Style="{StaticResource IconButtonStyle}">
                                                <materialDesign:PackIcon Kind="Upload" Width="16" Height="16"/>
                                            </Button>
                                        </WrapPanel>

                                        <Separator Margin="0,12,0,12" Background="{StaticResource BorderSubtle}"/>

                                        <!-- Row 2: Toggles & Background Configuration -->
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkRecordMouse" Content="Rekam Jalur Mouse" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,20,6"/>
                                            <CheckBox x:Name="ChkSmartPlayback" Content="Smart Playback" IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,20,6"/>
                                            <CheckBox x:Name="ChkDynamicThreshold" Content="Dynamic Minimal Zone" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,20,6"/>
                                            <CheckBox x:Name="ChkBackgroundMode" Content="Run in Background" Style="{StaticResource ToggleSwitchStyle}" FontWeight="SemiBold" Margin="0,0,12,6"
                                                      Checked="ChkBackgroundMode_CheckedChanged" Unchecked="ChkBackgroundMode_CheckedChanged"/>
                                        </WrapPanel>

                                        <!-- Background Window Selection Options -->
                                        <StackPanel x:Name="PnlBackgroundOptions" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                                            <TextBlock Text="Target Jendela:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="CmbBackgroundWindow" Width="200" Height="32" FontSize="12" DisplayMemberPath="Title" SelectedValuePath="Handle" VerticalContentAlignment="Center"/>
                                            <Button x:Name="BtnRefreshWindows" Click="BtnRefreshWindows_Click" Width="32" Height="32" Margin="6,0,0,0" Padding="0" Style="{StaticResource OutlinedButtonStyle}" ToolTip="Refresh Daftar Jendela">
                                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14"/>
                                            </Button>
                                            <CheckBox x:Name="ChkOffscreenMode" Content="Sembunyikan Jendela (Offscreen)" Style="{StaticResource ToggleSwitchStyle}" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Pindahkan jendela target ke area tersembunyi tanpa mengubah ukurannya"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- DataGrid Table (Clean White Container) -->
                                <Border Style="{StaticResource PremiumCard}" Padding="0" Margin="0,0,0,14">
                                    <DataGrid x:Name="DgActions" MinHeight="180" MaxHeight="340" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              PreviewMouseRightButtonDown="DgActions_PreviewMouseRightButtonDown"
                                              Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                                              Foreground="{StaticResource TextPrimary}" BorderThickness="0" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#F1F5F9"
                                              HeadersVisibility="Column" ColumnHeaderHeight="36" RowHeight="40" FontSize="13">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#EEF2FF"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Accent500}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtle}">
                                                <MenuItem Header="Atur Persentase Kecocokan" Click="MenuEditThreshold_Click"/>
                                                <MenuItem Header="Atur Waktu Tunggu" Click="MenuEditSmartWait_Click"/>
                                                <Separator Background="{StaticResource BorderSubtle}"/>
                                                <MenuItem Header="Hapus Aksi" Click="MenuDeleteAction_Click" Foreground="{StaticResource StatusDelete}"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BmrDataGridHeader}"/>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="No." Binding="{Binding Index}" Width="50"/>
                                            <DataGridTextColumn Header="Tipe Aksi" Binding="{Binding Action}" Width="130"/>
                                            <DataGridTextColumn Header="Detail Parameter" Binding="{Binding DisplayDetails}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Activity Log Box -->
                                <Border Style="{StaticResource PremiumCard}" Padding="14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <materialDesign:PackIcon Kind="TextSubject" Width="15" Height="15" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Log Aktivitas" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtLog" Height="85" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas" FontSize="11" Foreground="#334155" Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 1: Settings -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                                <TextBlock Text="Pengaturan Sistem" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                                <Border Style="{StaticResource PremiumCard}" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Macro Loop Configuration" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Tentukan berapa kali makro akan diulang otomatis (0 = Infinite loop)." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,14"/>

                                        <TextBox x:Name="TxtLoopCount" Text="1" Style="{StaticResource InputStyle}" Width="160" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>