<Window x:Class="MacroBMR.TargetPickerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TargetPickerOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#02000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Focusable="True"
        WindowState="Normal">
    <Canvas x:Name="MainCanvas" ClipToBounds="False">
        <!-- Floating HUD Header (Pusat Atas Layar) -->
        <Border x:Name="HudHeader"
                Background="#EE0F172A"
                BorderBrush="#6366F1"
                BorderThickness="1.5"
                CornerRadius="8"
                Padding="16,8"
                Canvas.Top="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎯" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTitle"
                           Text="Mode Penunjuk Visual: Klik tombol/elemen yang diinginkan"
                           Foreground="#FFFFFF"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <Border Width="1" Height="14" Background="#334155" Margin="12,0"/>
                <TextBlock Text="Aplikasi/game aman (tidak akan terpencet) • Tekan ESC untuk batal"
                           Foreground="#94A3B8"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Dynamic Target Scope Box mengikuti kursor -->
        <Border x:Name="ScopeBox"
                Width="100"
                Height="100"
                BorderBrush="#EC4899"
                BorderThickness="1.5"
                CornerRadius="4"
                Background="#10EC4899"
                IsHitTestVisible="False">
            <Grid>
                <!-- Crosshair halus di tengah -->
                <Line X1="45" Y1="50" X2="55" Y2="50" Stroke="#EC4899" StrokeThickness="1"/>
                <Line X1="50" Y1="45" X2="50" Y2="55" Stroke="#EC4899" StrokeThickness="1"/>
            </Grid>
        </Border>

        <!-- Coordinate Badge kecil di dekat kursor -->
        <Border x:Name="CoordBadge"
                Background="#CC0F172A"
                CornerRadius="4"
                Padding="6,2"
                IsHitTestVisible="False">
            <TextBlock x:Name="TxtCoord" Text="X: 0, Y: 0" Foreground="#E2E8F0" FontSize="10" FontWeight="Bold"/>
        </Border>
    </Canvas>
</Window>
