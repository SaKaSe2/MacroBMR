<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>NU1701</NoWarn>
    <!-- Hindari subfolder berlapis TargetFramework dan RID di dalam bin -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);NexusClick\**</DefaultItemExcludes>
    <AssemblyName>MacroBMR</AssemblyName>
    <Version>1.0.0.0</Version>
    <Company>BMR Studio</Company>
    <Description>BMR Macro Recorder &amp; Studio</Description>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AdvancedSharpAdbClient" Version="3.6.16" />
    <PackageReference Include="InputSimulatorPlus" Version="1.0.7" />
    <PackageReference Include="MouseKeyHook" Version="5.7.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="MaterialDesignColors" Version="2.1.4" />
  </ItemGroup>

  <!-- Hapus folder intermediate setelah publish, sisakan hanya folder publish -->
  <Target Name="CleanIntermediateBinAfterPublish" AfterTargets="Publish">
    <Exec Command="cmd.exe /c &quot;rd /s /q \&quot;$(BaseOutputPath)$(Configuration)\&quot; 2&gt;nul &amp; exit 0&quot;" IgnoreExitCode="true" />
  </Target>

</Project>
